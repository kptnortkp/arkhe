# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Public dev-only values that production refuses.
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database, backups and the dev mail outbox
/data/
/data/outbox/
# local recording and MIDI files (one folder per database)
data/uploads*/
.idea/

# project subagents are versioned (overrides a global .claude/ ignore)
!.claude/
.claude/*
!.claude/agents/
