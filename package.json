{
  "name": "arkhe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:studio": "drizzle-kit studio",
    "create-admin": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "e2e": "node --env-file-if-exists=.env.development --env-file-if-exists=.env e2e/run.mjs",
    "e2e:prod": "node e2e/prod.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run db:backup && drizzle-kit migrate && npm run db:check",
    "db:reset": "node --env-file-if-exists=.env scripts/assert-local-db.mjs && rm -f data/arkhe.db* && drizzle-kit migrate && npm run db:check && npm run seed",
    "db:backup": "tsx --env-file-if-exists=.env scripts/db-backup.ts",
    "db:check": "tsx --env-file-if-exists=.env scripts/db-check.ts",
    "db:decrypt": "tsx scripts/db-decrypt.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "brand:assets": "tsx scripts/brand-assets.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@libsql/client": "^0.18.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "10.1.7",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fontkit": "^2.0.4",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
