# Copy to .env for local development. In production set these in the host's dashboard,
# never in a file. Never put the Turso URL or token in .env: dev, seed and e2e read it.

# Public origin used in invite and password links. Production: https://<your-domain>
# (origin only, no path). Local: http://127.0.0.1:3100
APP_URL=http://127.0.0.1:3100

# Database. Local: a SQLite file. Production: the Turso URL, libsql://<db>-<org>.turso.io
DATABASE_URL=file:data/arkhe.db

# Turso auth token; required when DATABASE_URL is libsql://, https:// or wss://. Empty locally.
DATABASE_AUTH_TOKEN=

# "1" only on Vercel, whose proxy overwrites X-Forwarded-For / X-Real-IP; turns on per-IP
# login limits. Leave unset locally and on Render. Any other value stops the server at boot.
TRUST_PROXY_HEADERS=

# Set by the platform, not by you: NODE_ENV, VERCEL, RENDER, NEXT_RUNTIME, NEXT_PHASE.
# In production the server refuses to start on a bad APP_URL / DATABASE_URL / token
# (src/lib/env.ts).

# e2e only (npm run e2e / e2e:prod); never set in production. Left commented: an empty
# value would override the defaults.
# Base URL the suite targets; must be loopback.
# E2E_BASE_URL=http://127.0.0.1:3100
# Directory for screenshots.
# E2E_SHOTS=/tmp/arkhe-shots

# Monthly backup email (README: "Aylık yedek e-postası"). Production: set these in Vercel,
# Production scope only, typed by hand. Outside production mail always goes to data/outbox/.
# The two dev values below also live in .env.development and are refused in production.
# Choir Gmail address that sends the email.
# SMTP_USER=
# Gmail App Password (16 letters; spaces are ignored).
# SMTP_PASS=
# Optional sender, e.g. "Arkhe Portal" <koro@example.org>; default: "Arkhe Portal" <SMTP_USER>.
# SMTP_FROM=
# Only if Gmail refuses the sign-in: a free fallback provider's host (default smtp.gmail.com).
# SMTP_HOST=
# Its port (default 465 = TLS; any other port uses STARTTLS).
# SMTP_PORT=
# Encrypts the backup attachment; at least 16 characters (openssl rand -base64 24).
BACKUP_PASSPHRASE=dev-only-backup-passphrase
# Bearer Vercel Cron sends; production needs at least 32 characters (openssl rand -hex 32).
CRON_SECRET=dev-only-cron-secret
